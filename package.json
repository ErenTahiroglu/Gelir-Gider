{
  "name": "gelir-gider-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-file /dev/null",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "node --import tsx scripts/pg-runtime-verify.ts",
    "test:pg:real": "node --import tsx scripts/pg-real-concurrency-verify.ts",
    "build": "vite build",
    "dev:ui": "vite",
    "typecheck:ui": "tsc -p frontend/tsconfig.json --noEmit",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "check": "npm run cf-typegen && npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:ui": "npm run typecheck:ui && npm run test:ui && npm run build",
    "check:all": "npm run check && npm run check:ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vitest-plugin": "1.1.3",
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
