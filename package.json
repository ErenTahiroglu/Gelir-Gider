{
  "name": "gelir-gider-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "node --import tsx scripts/pg-runtime-verify.ts",
    "check": "npm run cf-typegen && npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vitest-plugin": "1.1.3",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.4.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
