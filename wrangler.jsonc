{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gelir-gider-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/health",
			"/ready",
			"/auth/*",
			"/budget-v2/*",
			"/credit-cards/*",
			"/transactions/*",
			"/manual-expenses/*",
			"/quick-entry/*",
			"/spending/*",
			"/people/*",
			"/short-term-goals/*",
			"/midas/*",
			"/long-term/*",
			"/income/*",
			"/month-close/*",
			"/imports/*",
			"/notifications/*",
			"/rewards/*",
			"/campaigns/*",
			"/ledger/*"
		]
	},
	"triggers": {
		"crons": ["0 * * * *", "17 2 * * *"]
	},
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "731001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "gelir-gider-backups"
		}
	]
}
